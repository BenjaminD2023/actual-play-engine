{
  "name": "@actualplay/engine",
  "version": "0.1.0",
  "description": "Show-control and live-play engine for D&D actual plays (QLab, MIDI, combat, audience).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "import": "./dist/store/sqlite.js"
    },
    "./vtt": {
      "types": "./dist/vtt/index.d.ts",
      "import": "./dist/vtt/index.js"
    },
    "./production": {
      "types": "./dist/production/index.d.ts",
      "import": "./dist/production/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate-show": "vitest run tests/simulate-show.test.ts"
  },
  "dependencies": {
    "@actualplay/protocol": "0.1.0",
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
